class "GeometryCurvePoints" "GeometryParticle" {
    #version 0.1
    category "/Geometry/Particle"
    doc "Repartit des points le long d'une courbe passant par des points de controle. Le Scatterer natif s'en sert comme support pour instancier : c'est la facon de poser des lampadaires sur un chemin, des pierres sur un sentier ou des rivets sur une arete."

    attribute_group "curve" {
        doc "La courbe suivie."

        reference "points_geometry" {
            filter "Geometry"
            input "motion" "geometry" "motion_blur"
            output "geometry"
            doc "Une geometrie dont les points servent de points de controle, a la place de la table. Un nuage de points disperse sur une surface, un Scatterer, un maillage : tout ce qui porte des points fait l'affaire. C'est la voie pour generer des cables en masse plutot que de les poser un par un."
        }

        long "points_order" {
            output "geometry"
            doc "Dans quel ordre parcourir les points de la geometrie. L'ordre du nuage donne une courbe qui zigzague d'un bout a l'autre ; le chainage part du premier point et prend chaque fois le plus proche, ce qui traverse le nuage sans revenir sur ses pas."
            preset "Ordre du nuage" "0"
            preset "Plus proche voisin" "1"
            value 1
        }

        list<reference> "control_points" {
            filter "SceneItem"
            input "motion" "geometry" "motion_blur"
            output "geometry"
            doc "Les points de controle, dans l'ordre. Il en faut au moins deux."
        }

        bool "closed" {
            output "geometry"
            doc "Referme la courbe sur elle-meme."
            value no
        }

        long "interpolation" {
            output "geometry"
            doc "Lisse fait passer une courbe douce par les points. Coudes relie les points par des segments droits raccordes par des arcs, comme la tuyauterie."
            preset "Lisse" "0"
            preset "Coudes" "1"
            preset "Cable qui pend" "2"
            value 0
        }

        distance "bend_radius" {
            output "geometry"
            doc "Rayon des coudes. Il est reduit automatiquement quand le segment est trop court pour le contenir."
            animatable yes
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 5
            value 0.3
        }

        percentage "slack" {
            output "geometry"
            doc "Mou du cable, en fraction de la distance entre deux points d'accroche. 5 pour cent veut dire cinq pour cent de longueur en plus que la ligne droite. C'est un rapport, donc le reglage tient quand on deplace un point."
            animatable yes
            numeric_range yes 0.0 10
            ui_range yes 0.0 0.5
            value 0.05
        }

        double[3] "gravity" {
            output "geometry"
            doc "Direction vers laquelle le cable pend."
            animatable yes
            value 0.0 -1 0.0
        }

        long "steps" {
            output "geometry"
            doc "Finesse de l'echantillonnage de la courbe. Sert a mesurer sa longueur, pas a placer les points."
            numeric_range yes 1 200
            ui_range yes 1 32
            value 16
        }
    }

    attribute_group "noise" {
        doc "L'irregularite d'un cable pose a la main. Le deplacement est pris perpendiculairement a la courbe, donc il ne change ni sa longueur ni les UV."

        distance "noise_amplitude" {
            output "geometry"
            doc "Amplitude du deplacement. A zero, la courbe reste lisse."
            animatable yes
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 1
            value 0.0
        }

        double "noise_frequency" {
            output "geometry"
            doc "Nombre d'ondulations par unite de longueur monde. Se compte en unites et non en fraction de courbe, pour qu'un cable deux fois plus long ait les memes ondulations et non des ondulations deux fois plus larges."
            animatable yes
            numeric_range yes 1e-05 1000
            ui_range yes 0.05 5
            value 0.5
        }

        long "noise_octaves" {
            output "geometry"
            doc "Nombre de couches de bruit. Une couche donne une ondulation regulière, trois ajoutent le tremblement fin qui se voit en gros plan."
            numeric_range yes 1 8
            ui_range yes 1 4
            value 2
        }

        percentage "noise_roughness" {
            output "geometry"
            doc "Force de chaque couche par rapport a la precedente."
            numeric_range yes 0.0 1
            value 0.5
        }

        long "noise_seed" {
            output "geometry"
            doc "Change le motif sans changer son caractere. C'est ce qui evite que dix cables cotes a cotes soient identiques."
            numeric_range yes 0.0 1000000
            value 0
        }

        distance "noise_fade" {
            output "geometry"
            doc "Longueur sur laquelle le bruit s'eteint aux deux extremites. Un cable branche ne bouge pas la ou il est accroche."
            animatable yes
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 2
            value 0.3
        }

        percentage "noise_gravity_bias" {
            output "geometry"
            doc "Tire le bruit vers le bas plutot que dans toutes les directions. Un cable s'affaisse plus qu'il ne se souleve."
            animatable yes
            numeric_range yes 0.0 1
            value 0.3
        }
    }

    attribute_group "distribution" {
        doc "Ou tombent les points."

        long "mode" {
            output "geometry"
            doc "Nombre fixe repartit N points sur toute la longueur. Espacement en pose un tous les tant, et le compte depend de la longueur de la courbe."
            preset "Nombre fixe" "0"
            preset "Espacement" "1"
            preset "Extremites" "2"
            value 0
        }

        long "count" {
            output "geometry"
            doc "Nombre de points, en mode Nombre fixe."
            animatable yes
            numeric_range yes 1 1000000
            ui_range yes 1 100
            value 10
        }

        distance "spacing" {
            output "geometry"
            doc "Distance entre deux points, en mode Espacement."
            animatable yes
            numeric_range yes 1e-05 1000000
            ui_range yes 0.01 10
            value 1
        }

        percentage "offset" {
            output "geometry"
            doc "Decale tous les points le long de la courbe, en fraction de l'ecart entre deux."
            animatable yes
            numeric_range yes -1 1
            value 0.0
        }

        distance "end_offset" {
            output "geometry"
            doc "En mode Extremites, fait rentrer les deux points dans le cable. Le regler sur la meme valeur que le Trim du tube pose l'embout exactement la ou la gaine s'arrete, de sorte qu'il la recouvre. Une valeur negative le sort au contraire du cable."
            animatable yes
            ui_range yes -1 1
            value 0.0
        }

        bool "include_last" {
            output "geometry"
            doc "En mode Nombre fixe, poser le dernier point exactement au bout. Sans lui, les points sont repartis comme des intervalles et le bout reste libre."
            value yes
        }
    }

    attribute_group "orientation" {
        doc "Ce que le Scatterer lira comme normale pour orienter les instances."

        long "normal_source" {
            output "geometry"
            doc "Tangente aligne les instances sur la direction de la courbe. Normale et binormale donnent les deux axes perpendiculaires du repere a torsion minimale. Y monde garde les instances droites quoi que fasse la courbe."
            preset "Tangente" "0"
            preset "Normale" "1"
            preset "Binormale" "2"
            preset "Y monde" "3"
            value 0
        }

        distance "lateral_offset" {
            output "geometry"
            doc "Ecarte les points de la courbe le long de la normale. Sert a poser quelque chose le long d'un bord plutot que dessus."
            animatable yes
            ui_range yes -10 10
            value 0.0
        }
    }
}

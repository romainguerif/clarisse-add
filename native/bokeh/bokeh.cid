class "ImageFilterBokeh" "KernelFilter" {
    ui_name "Bokeh [ClarisseAdd]"
    #version 0.1
    category "ImageFilter"
    doc "Flou de mise au point optique. Contrairement a Defocus Blur, le noyau reproduit un vrai diaphragme -- nombre de lames, courbure, rotation, anamorphisme -- et les hautes lumieres se rassemblent en boules nettes au lieu d'etre etalees. Les defauts d'optique qui font le realisme (vignettage optique, aberration spherique, aberration chromatique) sont exposes en parametres."

    attribute_group "Aperture" {
        subpixel "radius" {
            doc "Rayon du bokeh, en pixels -- le rayon du cercle de confusion, la taille qu'occupe un point lumineux hors mise au point. Quand une image de profondeur est branchee, c'est le rayon MAXIMAL : le rayon reel varie par pixel entre zero et cette valeur."
            value 8.0
            numeric_range yes 0.0 250
            ui_range yes 0.0 50
            slider yes
            animatable yes
        }
        long "blades" {
            doc "Nombre de lames du diaphragme. A zero, l'ouverture est un disque parfait -- ce que donne un objectif a pleine ouverture. Entre 5 et 9, on retrouve la forme polygonale des optiques diaphragmees."
            value 0
            numeric_range yes 0 32
            ui_range yes 0 12
            slider yes
            animatable yes
        }
        angle "rotation" {
            doc "Rotation du diaphragme. Sans effet quand blades vaut zero."
            value 0.0
            animatable yes
        }
        percentage "roundness" {
            doc "Courbure des lames. A zero les lames sont droites et l'ouverture est un polygone exact. Vers 100% elles bombent et l'ouverture tend vers le disque ; vers -100% elles se creusent et donnent la forme etoilee des optiques anciennes."
            value 0.0
            numeric_range yes -1.0 1.0
            ui_range yes -1.0 1.0
            slider yes
            animatable yes
        }
        percentage "softness" {
            doc "Douceur du bord de l'ouverture. A zero le bord est franc, comme celui d'un diaphragme metallique bien decoupe. En montant, la transition s'etale et les boules perdent leur contour net -- ce que donnent les optiques a lames usees, ou les filtres diffuseurs."
            value 0.0
            numeric_range yes 0.0 1.0
            ui_range yes 0.0 1.0
            slider yes
            animatable yes
        }
        percentage "anamorphism" {
            doc "Ovalisation du bokeh. Les optiques anamorphiques compriment l'image horizontalement, ce qui etire les boules de lumiere en verticale. Valeur positive : etirement vertical. Negative : horizontal."
            value 0.0
            numeric_range yes -1.0 1.0
            ui_range yes -1.0 1.0
            slider yes
            animatable yes
        }
    }

    attribute_group "Focus" {
        tag "depth_aov" {
            doc "AOV de profondeur a utiliser. Vide, le rayon est constant sur toute l'image -- un flou uniforme, pas une mise au point. La liste ne propose que les AOV reellement presents : il faut donc d'abord les activer sur le Layer 3D, groupe AOV, comme pour le denoiser OptiX."
            filter "aov_groups"
            value ""
        }
        reference "focus_object" {
            doc "Objet sur lequel faire le point, comme sur une camera. Renseigne, il rend Focus Distance inutile : la profondeur est relevee a chaque image entre la camera du layer et cet objet, donc la mise au point suit l'animation des deux. C'est de loin le plus pratique -- une distance en unites de scene ne se devine pas, et elle change des que quelque chose bouge. Il faut quand meme un AOV de profondeur ci-dessus : sans lui, le filtre ne sait pas ou se trouve le reste de la scene et floute tout uniformement."
            filter "SceneItem"
            value ""
        }
        long "depth_mode" {
            doc "Comment lire les valeurs de l'AOV. Distance reelle : la valeur est une profondeur en unites de scene, ce que rend l'AOV depth de Clarisse. Inverse : la valeur est 1/z, comme le donnent certains moteurs et la plupart des tampons de profondeur temps reel."
            value 0
            preset "Distance reelle" "0"
            preset "Inverse (1/z)" "1"
        }
        distance "focus_distance" {
            doc "Distance de mise au point, en unites de scene, mesuree le long de l'axe de la camera. Ce qui se trouve a cette profondeur reste net ; le flou croit de part et d'autre. Ignore des qu'un objet est renseigne ci-dessus."
            value 10.0
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 200
            slider yes
            animatable yes
        }
        distance "focus_range" {
            doc "Profondeur de la zone nette, de part et d'autre de la distance de mise au point. C'est l'equivalent artistique d'une ouverture : plus la zone est etroite, plus le flou monte vite."
            value 2.0
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 50
            slider yes
            animatable yes
        }
        double "blur_falloff" {
            doc "Vitesse a laquelle le flou croit une fois sorti de la zone nette. A 1 la croissance est lineaire jusqu'au rayon maximal ; au-dela elle est plus douce pres du point de mise au point et plus brutale loin."
            value 1.0
            numeric_range yes 0.1 8.0
            ui_range yes 0.25 4.0
            slider yes
            animatable yes
        }
        long "focus_side" {
            doc "Quel cote flouter. Une profondeur de champ reelle floute des deux cotes, mais isoler l'arriere-plan ou l'avant-plan est un besoin courant en compositing."
            value 0
            preset "Avant et arriere" "0"
            preset "Arriere seulement" "1"
            preset "Avant seulement" "2"
        }
        double "front_multiplier" {
            doc "Multiplie le flou de ce qui est DEVANT le plan de nettete, sans toucher a l'arriere-plan. Un premier plan flou se remarque beaucoup plus qu'un arriere-plan flou, et c'est presque toujours lui qu'il faut retenir ou pousser separement."
            value 1.0
            numeric_range yes 0.0 10.0
            ui_range yes 0.0 3.0
            slider yes
            animatable yes
        }
        double "back_multiplier" {
            doc "Multiplie le flou de ce qui est DERRIERE le plan de nettete, sans toucher au premier plan. C'est le reglage de separation du sujet et du decor."
            value 1.0
            numeric_range yes 0.0 10.0
            ui_range yes 0.0 3.0
            slider yes
            animatable yes
        }
    }

    attribute_group "Slices" {
        long "corrective_slices" {
            doc "Nombre de tranches de profondeur traitees separement. C'est le reglage qui decide de la qualite des BORDS, pas de la quantite de flou.\n\nA 1, l'image est floutee en une seule passe : le rayon est pris dans la profondeur du pixel d'arrivee, ce qui est rapide mais faux des que deux profondeurs se cotoient. Un premier plan flou garde alors une silhouette dure au lieu de se dissoudre sur le decor, et un sujet net bave sur l'arriere-plan flou qui l'entoure.\n\nA 2, l'avant et l'arriere sont separes. Au-dela, la profondeur est decoupee en autant de tranches, chacune floutee seule a rayon constant puis recomposee de l'arriere vers l'avant : c'est ce qui rend les bords justes, au prix d'un temps de calcul a peu pres proportionnel. 10 est un bon compromis ; monter au-dela ne se voit que sur des degrades de profondeur tres etales."
            value 10
            numeric_range yes 1 64
            ui_range yes 1 24
            slider yes
        }
    }

    attribute_group "Highlights" {
        double "threshold" {
            doc "Seuil de reprise des hautes lumieres, en luminance lineaire. Au-dessus de cette valeur, l'energie est amplifiee avant le flou puis restituee apres : c'est ce qui transforme un point brillant en boule de bokeh nette au lieu de l'ecraser. Le calcul se fait en lineaire ; regler ce seuil sur une image en gamma n'a pas de sens."
            value 1.0
            numeric_range yes 0.0 1000000
            ui_range yes 0.0 10
            slider yes
            animatable yes
        }
        double "gain" {
            doc "Amplification appliquee a ce qui depasse le seuil. A zero le filtre est neutre et conserve l'energie exactement -- c'est le comportement physique, et il suffit en lineaire non ecrete. Au-dela, les boules ressortent davantage : c'est un forcage artistique."
            value 0.0
            numeric_range yes 0.0 100
            ui_range yes 0.0 8
            slider yes
            animatable yes
        }
    }

    attribute_group "Optics" {
        bool "preserve_exposure" {
            doc "Le vignettage optique reduit reellement la lumiere qui atteint les coins : c'est ce qu'est un vignettage. Coche cette case pour n'en garder que la forme en amande sans l'assombrissement, ce qu'attendent la plupart des compositeurs -- ils gerent l'exposition separement."
            value no
        }
        percentage "optical_vignetting" {
            doc "Vignettage optique, dit oeil-de-chat. Vers les bords du cadre, le barillet de l'objectif rogne le faisceau et les boules rondes deviennent des amandes orientees vers le centre. C'est un defaut, et c'est ce qui trahit une vraie optique."
            value 0.0
            numeric_range yes 0.0 1.0
            ui_range yes 0.0 1.0
            slider yes
            animatable yes
        }
        percentage "spherical_aberration" {
            doc "Repartition de l'energie dans la boule. A zero elle est uniforme. En positif, l'energie migre vers le bord et donne l'anneau lumineux dit bulle de savon. En negatif elle se concentre au centre, et le bokeh devient doux comme celui des optiques a portrait."
            value 0.0
            numeric_range yes -1.0 1.0
            ui_range yes -1.0 1.0
            slider yes
            animatable yes
        }
        percentage "chromatic_aberration" {
            doc "Frange coloree au bord des boules. L'objectif ne fait pas converger toutes les longueurs d'onde au meme endroit : le rayon du bokeh differe legerement par canal. Valeur positive : le rouge deborde. Negative : le bleu."
            value 0.0
            numeric_range yes -1.0 1.0
            ui_range yes -0.5 0.5
            slider yes
            animatable yes
        }
    }
}

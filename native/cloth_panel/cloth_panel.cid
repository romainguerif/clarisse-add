class "GeometryClothPanel" "GeometryPolymesh" {
    #version 0.3
    category "/Geometry/Polymesh"
    doc "Transforme chaque polygone d'un maillage en coussin capitonne. La forme n'est pas dessinee mais simulee : une membrane cousue sur le contour du polygone, a qui on donne plus de matiere qu'il n'en faut, et qu'une pression interne pousse vers l'exterieur. Les bourrelets et les plis naissent de ce surplus, comme sur un vrai coussin. Tout est resolu dans un repere normalise par la taille du coussin, donc les memes reglages tiennent sur un matelas de six metres comme sur une facette de sphere centimetrique."

    attribute_group "input" {
        doc "Le maillage a capitonner."

        reference "input_geometry" {
            filter "Geometry"
            input "shading_variable" "motion" "geometry" "motion_blur"
            output "geometry"
            dirtiness_pass_through yes
            doc "Le maillage dont chaque polygone devient un coussin. Sa topologie dessine le capitonnage : des quads reguliers donnent un matelas, une sphere facettee donne la boule a coussins."
        }

        string "shading_group" {
            output "geometry"
            doc "Ne capitonner que les polygones de ce shading group. Laisse vide, le node regarde qui l'alimente : si c'est un node de selection, il prend son groupe tout seul -- brancher la selection suffit donc, sans avoir a retaper son nom. Si l'amont n'est pas une selection, tout le maillage y passe. Une etoile force ce dernier cas malgre une selection en amont.\n\nUn nom qui ne correspond a aucun groupe ne produit rien du tout, volontairement : une faute de frappe doit se voir."
            value ""
        }

        long "resolution" {
            output "geometry"
            doc "Nombre de subdivisions par coussin. C'est ce qui borne la finesse des plis : un pli ne peut pas etre plus etroit qu'une maille. Les compliances etant normalisees par la taille de maille, monter la resolution affine le resultat sans changer la matiere."
            numeric_range yes 3 256
            ui_range yes 8 64
            value 14
        }

        long "levels" {
            output "geometry"
            doc "Nombre de niveaux de resolution resolus en cascade. La simulation part grossiere, puis chaque niveau reprend la forme du precedent et l'affine, jusqu'a la resolution demandee -- qui reste celle du resultat. Une relaxation en positions ne propage l'information que d'une arete par passe : sans cascade, il faudrait des milliers d'iterations pour que deux bords opposes se parlent."
            numeric_range yes 1 5
            ui_range yes 1 4
            value 3
        }

        distance "detail" {
            output "geometry"
            doc "Taille de maille visee, en unites du monde. A zero, tous les coussins ont la meme resolution. Au-dessus, chacun prend la sienne selon sa taille reelle : une grande face est plus finement decoupee qu'une petite, ce qui evite a la fois de gaspiller sur les petites et de manquer de details sur les grandes."
            ui_range yes 0.0 0.5
            value 0.0
        }

        long "max_resolution" {
            output "geometry"
            doc "Plafond de subdivision quand la taille de maille pilote la resolution. Il n'y a que lui pour empecher une seule grande face de faire exploser le nombre de sommets."
            numeric_range yes 3 256
            ui_range yes 8 96
            value 40
        }
    }

    attribute_group "cushion" {
        doc "La forme du coussin."

        double "pressure" {
            output "geometry"
            doc "La force qui gonfle le coussin. C'est une force et non un volume vise : elle pousse sans jamais etre satisfaite, et le gonflement s'arrete quand la tension de la membrane l'equilibre. La hauteur du coussin est donc un resultat, pas une consigne -- c'est ce qui rend la forme juste sans qu'on ait a la decrire. Monter la pression tend le tissu et efface les plis ; la baisser le laisse mou et froisse."
            animatable yes
            numeric_range yes 0.0 100
            ui_range yes 0.5 8
            value 2.5
        }

        long "pin_rings" {
            output "geometry"
            doc "Nombre d'anneaux de mailles epingles le long de la couture. Un seul laisse le bourrelet deborder sur le sillon ; deux raidissent l'attache et donnent une bordure franche. C'est le reglage que les solveurs de tissu appellent le groupe d'epinglage."
            numeric_range yes 1 8
            ui_range yes 1 4
            value 2
        }

        percentage "seam" {
            output "geometry"
            doc "Largeur du mplat de couture, en fraction du coussin. Le tissu y reste plat, au niveau du sillon, et sans surplus : les plis y meurent, et le bombement ne commence qu'apres. C'est ce qui donne une bordure nette au lieu d'un bourrelet mou qui deborde sur la couture."
            animatable yes
            numeric_range yes 0.0 0.49
            ui_range yes 0.02 0.2
            value 0.06
        }

        percentage "seam_depth" {
            output "geometry"
            doc "Profondeur du sillon, en fraction du rayon du coussin. Le contour est enfonce le long des normales aux sommets du maillage d'entree, donc deux coussins voisins enfoncent leur arete commune exactement au meme endroit -- une sphere capitonnee ne s'ouvre pas."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.2
            value 0.06
        }

    }

    attribute_group "seam" {
        doc "La couture. C'est elle qui porte le detail : sur un vrai panneau capitonne, le dessus est lisse et tendu, et tout le tissu en trop est ramasse le long de la couture ou il se fronce en une corde de plis tres fins."

        percentage "seam_gather" {
            output "geometry"
            doc "Surplus de tissu fronce dans le mplat de couture. C'est le detail le plus caracteristique des panneaux cousus, et celui qu'on voit en premier de pres. Le rembourrage y est ignore -- il n'y en a pas sous une couture -- donc ce tissu est libre de se chiffonner."
            animatable yes
            numeric_range yes 0.0 2
            ui_range yes 0.0 0.8
            value 0.3
        }

        percentage "seam_wrinkle_scale" {
            output "geometry"
            doc "Largeur des plis du fronce, en fraction du coussin. Beaucoup plus fine que celle des plis du coussin : c'est ce qui fait la difference entre une couture et un bourrelet. Un pli ne peut pas etre plus etroit que quatre mailles, donc descendre ici demande de monter la resolution -- a 0.05 il faut au moins 80 subdivisions."
            animatable yes
            numeric_range yes 0.01 1
            ui_range yes 0.03 0.2
            value 0.07
        }
    }

    attribute_group "fabric" {
        doc "Le tissu : combien il y en a, et comment il se comporte."

        percentage "wrinkles" {
            output "geometry"
            doc "De combien le tissu est plus grand que la place ou on le coud. C'est le reglage des plis, et le seul qui en cree : une fois la membrane gonflee, ce tissu en trop n'a nulle part ou aller. Dix pour cent est la valeur qu'emploient les solveurs de tissu pour un panneau capitonne."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.3
            value 0.1
        }

        percentage "mesh_jitter" {
            output "geometry"
            doc "Desordre du maillage, en fraction de la maille. Une grille reguliere flambe en plis reguliers : c'est la bonne reponse a une question trop propre, mais ca donne une cannelure de colonne au lieu d'un tissu. Les solveurs de production remaillent le panneau en triangles irreguliers avant de simuler ; ce reglage fait la meme chose en deplacant les sommets dans leur plan, avant toute mesure de longueur. Les plis n'ont alors plus d'axe ou tomber."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.6
            value 0.35
        }

        percentage "wrinkle_variation" {
            output "geometry"
            doc "Irregularite de la quantite de tissu d'un endroit a l'autre. A zero les plis sortent parfaitement periodiques, comme les cannelures d'une colonne -- la grille est reguliere et rien ne vient la casser. Les vrais panneaux ne le sont pas : une couturiere ne coupe pas au dixieme de millimetre. Ce reglage module le surplus a basse frequence, ce qui deplace les plis sans changer leur largeur."
            animatable yes
            numeric_range yes 0.0 2
            ui_range yes 0.0 1
            value 0.4
        }

        percentage "corner_gather" {
            output "geometry"
            doc "Surplus supplementaire rentre dans les quatre coins. Un coin est le seul endroit ou le tissu est tenu dans deux directions a la fois : sur un vrai capitonnage c'est la qu'on rentre l'exces, et c'est de la que partent les plis en etoile."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.3
            value 0.08
        }

        percentage "wrinkle_reach" {
            output "geometry"
            doc "Ou se concentre le tissu en trop. Au-dela de 1 il est reparti uniformement, comme sur un vrai panneau ; en dessous il est ramasse pres de la couture, ce qui laisse le dessus lisse et donne une ceinture de plis. C'est un ecart volontaire au modele physique, utile quand on veut un capitonnage plus sage."
            animatable yes
            numeric_range yes 0.05 3
            ui_range yes 0.2 2
            value 2
        }

        double "stretch" {
            output "geometry"
            doc "Elasticite en tension. A zero le tissu est inextensible et tout le surplus part en plis ; en montant, il s'etire un peu au lieu de se plisser. Un vrai tissu tisse s'etire de quelques pourcents."
            animatable yes
            numeric_range yes 0.0 5
            ui_range yes 0.0 0.2
            value 0.02
        }

        double "compression" {
            output "geometry"
            doc "Combien le tissu cede plus facilement comprime qu'etire. A 1 il resiste autant dans les deux sens, ce qui est faux : un tissu resiste a l'etirement et flambe librement. Au-dessus, il peut se raccourcir localement -- c'est-a-dire empiler des plis plutot que d'en faire un seul grand."
            animatable yes
            numeric_range yes 1 100
            ui_range yes 1 20
            value 6
        }

        double "shear_stiffness" {
            output "geometry"
            doc "Souplesse en cisaillement. Un tissu tisse cede environ cent fois plus facilement en biais qu'en droit fil, et c'est ce qui laisse les plis prendre leurs diagonales. A zero la grille devient rigide en losange et les plis s'alignent sur elle."
            animatable yes
            numeric_range yes 0.0 1000
            ui_range yes 0.0 20
            value 4
        }

        double "crease_stretch" {
            output "geometry"
            doc "Force l'orientation des plis perpendiculairement a la couture. A 1, on laisse la simulation choisir -- et elle choisit bien, l'eventail nait tout seul du gonflement d'une membrane epinglee. Au-dessus, on impose la direction, ce qui donne un plisse plus regulier, presque une cannelure. C'est un effet de style, pas une correction."
            animatable yes
            numeric_range yes 1 12
            ui_range yes 1 6
            value 1
        }

        percentage "wrinkle_scale" {
            output "geometry"
            doc "Largeur des plis, en fraction du coussin. C'est la raideur de flexion du tissu, exprimee dans l'unite qui se voit : a 1 le tissu est raide et fait un seul grand pli, a 0.2 il est souple et en fait cinq. Le calcul suit la loi de Cerda -- la longueur d'onde de flambage va en racine quatrieme de la raideur -- et la valeur est normalisee par l'aire de maille, donc changer la resolution affine les plis sans changer la matiere. Un pli ne peut pas etre plus etroit que quatre mailles : en dessous, monter la resolution."
            animatable yes
            numeric_range yes 0.01 2
            ui_range yes 0.12 0.8
            value 0.28
        }

        distance "wrinkle_size" {
            output "geometry"
            doc "La meme largeur de pli, mais en unites du monde. A zero, les plis restent proportionnels au coussin : meme aspect quelle que soit la taille de l'objet. Au-dessus, ils prennent une taille absolue -- un grand coussin en fait donc beaucoup et des fins, un petit deux ou trois. C'est le comportement d'un vrai tissu, dont la raideur ne sait rien de la taille de ce qu'on en coud, et c'est ce reglage qui rend une scene a plusieurs echelles credible."
            ui_range yes 0.0 1
            value 0.0
        }
    }

    attribute_group "gravity" {
        doc "La pesanteur. Elle rompt la symetrie du coussin et lui donne un dessus different de son dessous."

        double[3] "gravity" {
            output "geometry"
            doc "Direction vers laquelle la membrane retombe. Seule la direction compte, la longueur est ignoree."
            animatable yes
            value 0.0 -1 0.0
        }

        percentage "gravity_strength" {
            output "geometry"
            doc "De combien le tissu retombe, en fraction du rayon du coussin. Zero par defaut, comme dans les solveurs de panneaux : un capitonnage tient a ses coutures et ne pend pas. A monter pour un coussin libre, ou pour casser la symetrie entre le dessus et le dessous."
            animatable yes
            numeric_range yes 0.0 2
            ui_range yes 0.0 0.3
            value 0.0
        }
    }

    attribute_group "solver" {
        doc "La resolution. Ces reglages changent la precision, pas la forme visee."

        long "substeps" {
            output "geometry"
            doc "Nombre de pas de temps. A 1 le solveur fait une relaxation statique : le tissu glisse vers l'equilibre lisse le plus proche de son point de depart. Au-dela, la vitesse entre en jeu -- le tissu depasse, revient, et se pose dans un etat bien plus plisse. Les deux sont des equilibres valides, mais c'est la dynamique qui va chercher le second, et c'est ce que font tous les solveurs de tissu de production. C'est le reglage qui separe deux grands plis d'un fronce dense."
            numeric_range yes 1 200
            ui_range yes 1 48
            value 24
        }

        percentage "damping" {
            output "geometry"
            doc "Part de la vitesse perdue a chaque pas. A zero le tissu oscille sans jamais se poser ; trop haut, il retombe dans la relaxation statique et perd ses plis. Quelques pourcents suffisent."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.2
            value 0.04
        }

        long "iterations" {
            output "geometry"
            doc "Nombre de passes de relaxation par pas de temps. Le solveur converge vers un equilibre bien defini, donc monter ce nombre affine la forme sans changer la matiere -- contrairement a un solveur en positions ordinaire, ou la raideur depend du budget. Le cout total est le produit par le nombre de pas."
            numeric_range yes 1 5000
            ui_range yes 6 60
            value 14
        }

        percentage "jitter" {
            output "geometry"
            doc "Bruit initial hors du plan, en fraction du coussin. Il est indispensable et non cosmetique : une membrane parfaitement plane est une configuration exactement stationnaire du solveur, et elle gonflerait sans jamais choisir de quel cote plier. Mais il doit rester une graine : mesure faite, le nombre de plis est le meme a un vingtieme de cette valeur. Le monter ne rend pas le tissu plus froisse, ca lui impose seulement le motif du bruit."
            animatable yes
            numeric_range yes 0.0 1
            ui_range yes 0.0 0.02
            value 0.002
        }

        long "smoothing" {
            output "geometry"
            doc "Passes de lissage apres la simulation. Le solveur laisse des irregularites de maille qui ne se voient pas sur la forme mais accrochent la lumiere en speculaire. Quelques passes tres douces les enlevent sans toucher aux plis, beaucoup plus larges qu'une maille."
            numeric_range yes 0.0 20
            ui_range yes 0.0 6
            value 2
        }

        percentage "smoothing_amount" {
            output "geometry"
            doc "Force de chaque passe de lissage."
            animatable yes
            numeric_range yes 0.0 1
            value 0.3
        }

        long "seed" {
            output "geometry"
            doc "Change le motif des plis sans changer leur caractere."
            numeric_range yes 0.0 1000000
            value 0
        }
    }
}

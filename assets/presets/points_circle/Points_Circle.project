                                }
                            }
                        }
                    }
                }
            }
        }
    }
    units {
        units_file "$CLARISSE_BIN_DIR/units.cfg"
        time "frame"
        distance "metric"
        distance_unit "meter"
        angle "degree"
        area "metric"
        area_unit "square_meter"
        frequency "frames_per_second"
        color "float"
        scale "multiplier"
    }
}
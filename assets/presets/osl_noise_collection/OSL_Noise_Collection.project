            positions "project://Scene_Noise_OSL/OSL" 0 0
            projection 6
            OSL_shader_script "/*\n * MA4D_voronoi.osl by Michel J. Anders (c)2012\n * from https://github.com/sambler/osl-shaders\n *\n * license: cc-by-sa\n *\n * original script from -\n * http://blenderthings.blogspot.com.au/2012/12/a-4d-voronoi-osl-shader-for-blender.html\n *\n */\n\n\nvoid cellnoise_color4d(float p[4], float c[4])\n{\n    c[0] = cellnoise(point(p[0],p[1],p[2]),p[3]);\n    c[1] = cellnoise(point(p[1],p[0],p[2]),p[3]);\n    c[2] = cellnoise(point(p[1],p[2],p[0]),p[3]);\n    c[3] = cellnoise(point(p[3],p[1],p[2]),p[0]);\n}\n\n/* Voronoi 4D . we always use distance squared as the distance metric */\n\nvoid voronoi4d(point p, float t, float da[4], point pa[4], float ta[4])\n{\n    /* returns distances in da, point coords in pa and time coords in ta*/\n    int xx, yy, zz, tt, xi, yi, zi, ti;\n\n    float op[4] = {p[0],p[1],p[2],t};\n\n    xi = (int)floor(p[0]);\n    yi = (int)floor(p[1]);\n    zi = (int)floor(p[2]);\n    ti = (int)floor(t);\n\n    da[0] = 1e10;\n    da[1] = 1e10;\n    da[2] = 1e10;\n    da[3] = 1e10;\n\n    for (xx = xi - 1; xx <= xi + 1; xx++) {\n        for (yy = yi - 1; yy <= yi + 1; yy++) {\n            for (zz = zi - 1; zz <= zi + 1; zz++) {\n                for (tt = ti - 1; tt <= ti + 1; tt++) {\n                    float ip[4] = {xx, yy, zz, tt};\n                    float vp[4];\n                    cellnoise_color4d(ip,vp);\n                    float pd[4] = { op[0] - (vp[0] + ip[0]),\n                        op[1] - (vp[1] + ip[1]),\n                        op[2] - (vp[2] + ip[2]),\n                        op[3] - (vp[3] + ip[3])};\n                    // always distance squared\n                    float d = pd[0]*pd[0]+pd[1]*pd[1]+pd[2]*pd[2]+pd[3]*pd[3];\n\n                    vp[0] += xx;\n                    vp[1] += yy;\n                    vp[2] += zz;\n                    vp[3] += tt;\n\n                    if (d < da[0]) {\n                        da[3] = da[2];\n                        da[2] = da[1];\n                        da[1] = da[0];\n                        da[0] = d;\n\n                        pa[3] = pa[2]; ta[3] = ta[2];\n                        pa[2] = pa[1]; ta[2] = ta[1];\n                        pa[1] = pa[0]; ta[1] = ta[0];\n                        pa[0] = point(vp[0],vp[1],vp[2]); ta[0] = vp[3];\n                    }\n                    else if (d < da[1]) {\n                        da[3] = da[2];\n                        da[2] = da[1];\n                        da[1] = d;\n\n                        pa[3] = pa[2]; ta[3] = ta[2];\n                        pa[2] = pa[1]; ta[2] = ta[1];\n                        pa[1] = point(vp[0],vp[1],vp[2]); ta[1] = vp[3];\n                    }\n                    else if (d < da[2]) {\n                        da[3] = da[2];\n                        da[2] = d;\n\n                        pa[3] = pa[2]; ta[3] = ta[2];\n                        pa[2] = point(vp[0],vp[1],vp[2]); ta[2] = vp[3];\n                    }\n                    else if (d < da[3]) {\n                        da[3] = d;\n                        pa[3] = point(vp[0],vp[1],vp[2]); ta[3] = vp[3];\n                    }\n                }\n            }\n        }\n    }\n}\n\nshader MA4D_voronoi(\n        vector Vector = P,\n        float Scale = 5.0,\n        float Time = 0,\n        output float Fac = 0.0,\n        output color Color = color(0.0) )\n{\n    /* compute distance and point coordinate of 4 nearest neighbours */\n    float da[4];\n    point pa[4];\n    float ta[4];\n\n    voronoi4d(Vector * Scale, Time * Scale, da, pa, ta);\n\n    Fac = fabs(da[0]); \n    Color = color(Fac);\n}\n"
            custom_attributes {
                attribute_group "output" {
                    string "OSL_output_name" {
                        doc "Select shader output to fill texture RGB color."
                        allow_expression no
                        preset "Fac" "Fac"
                        preset "Color" "Color"
                        value "Fac"
                    }
                }
                attribute_group "input" {
                    double[3] "OSL_Vector" {
                        doc "Vector"
                        texturable yes
                        animatable yes
                        shading_variable yes
                        allow_expression no
                        value 0.0 0.0 0.0
                        settings {
                            key "osl_semantic"
                            osl_settings 2
                        }
                    }
                    double "OSL_Scale" {
                        doc "Scale"
                        texturable yes
                        animatable yes
                        shading_variable yes
                        allow_expression no
                        value 16
                    }
                    double "OSL_Time" {
                        doc "Time"
                        texturable yes
                        animatable yes
                        shading_variable yes
                        allow_expression no
                        value 7
                    }
                }
            }
        }
    }
}

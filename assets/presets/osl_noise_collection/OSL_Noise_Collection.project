                                        attribute_groups "Scene Object Name" yes "Canvas" yes "Display" yes "Overscan" yes "Sampling" yes "Layers" yes "Output" yes "General" yes "Projection Mode" yes "Camera Projection" no "Projection Transform" yes "Uv Transform" yes "Shader" yes "Raytracing" yes "Informations" yes "Input" yes "Kinematics" yes "Advanced Kinematics" yes "3d View" yes "Rendering" yes "Lighting" yes "Arbitrary Output Variables" yes "Path Depth" yes "Visibility" yes "Anti Aliasing" yes "Tone Mapping" yes "Motion Blur" yes "Depth Of Field" yes "Alpha" yes "Material Sampling" yes "Light Visibility" yes "Indirect Path Depth" yes "Clamping" yes "Shading" yes "Deformation" yes "Displacement" yes "Utility" yes "Smoothing" yes "Geometry" yes "Caustics" no "Diffuse" yes "Diffuse Backlight" no "Diffuse Sss" no "Diffuse Advanced" no "Specular 1" yes "Specular 1 Fresnel" no "Specular 1 Advanced" no "Specular 2" no "Specular 2 Fresnel" no "Specular 2 Advanced" no "Transmission" no "Transmission Attenuation" no "Transmission Advanced" no "Emission" yes "Transform" yes "Blending" yes "Filters" yes "Channels" yes "Frame Range" yes "File Output" yes "Deep Output" yes "Uv Bake" yes "Range" yes "Aovs" yes "Sub Pixel Filters" yes "Subdivision Surfaces" yes "Attenuation" yes
